                            <input type="file" id="beforeImageInput" accept="image/*" style="display:none;" onchange="handleImageUpload(this, 'before')">
                        </div>

                        <div class="form-section">
                            <h3>💰 Account & Risk Management</h3>
                            <div class="form-row">
